# ─── DATABASE ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/discord_manager"

# ─── DISCORD BOT ────────────────────────────────────────────
DISCORD_TOKEN="your_discord_bot_token"
DISCORD_CLIENT_ID="your_discord_client_id"
DISCORD_CLIENT_SECRET="your_discord_client_secret"
DISCORD_GUILD_ID="your_discord_guild_id"

# ─── DISCORD CHANNELS ────────────────────────────────────────
DISCORD_SUCCESS_LOGS_CHANNEL_ID="channel_id"
DISCORD_ERROR_LOGS_CHANNEL_ID="channel_id"
DISCORD_STAFF_LOGS_CHANNEL_ID="channel_id"

# ─── DISCORD ROLES ───────────────────────────────────────────
DISCORD_BOSS_ROLE_ID="role_id"
DISCORD_ADMIN_ROLE_ID="role_id"
DISCORD_STAFF_ROLE_ID="role_id"
DISCORD_VIP_ROLE_ID="role_id"

# ─── DASHBOARD ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_minimum_32_chars"

# ─── INTERNAL API ────────────────────────────────────────────
BOT_API_PORT=4000
BOT_API_SECRET="your_internal_api_secret"

# ─── AI (ANNOUNCEMENTS) ──────────────────────────────────────
OPENAI_API_KEY="your_openai_api_key"

# ─── WEBSOCKETS ──────────────────────────────────────────────
WS_PORT=4001

# ─── ENVIRONMENT ─────────────────────────────────────────────
NODE_ENV="development"
