# ─── DATABASE ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/discord_manager"

# ─── DISCORD BOT ────────────────────────────────────────────
DISCORD_TOKEN="your_discord_bot_token"
DISCORD_CLIENT_ID="your_discord_client_id"
DISCORD_CLIENT_SECRET="your_discord_client_secret"
DISCORD_GUILD_ID="your_discord_guild_id"

# ─── DISCORD ROLES ───────────────────────────────────────────
DISCORD_BOSS_ROLE_ID="role_id"
DISCORD_ADMIN_ROLE_ID="role_id"
DISCORD_STAFF_ROLE_ID="role_id"
DISCORD_VIP_ROLE_ID="role_id"

# ─── DASHBOARD ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_minimum_32_chars"

# ─── INTERNAL API ────────────────────────────────────────────
BOT_API_PORT=4000
BOT_API_SECRET="your_internal_api_secret"
BOT_API_URL="http://localhost:4000"

# ─── WEBSOCKETS (WS partage le même port que BOT_API_PORT) ───
NEXT_PUBLIC_WS_URL="http://localhost:4000"
NEXT_PUBLIC_BOT_WS_URL="http://localhost:4000"

# ─── AI (OPENROUTER — configuré dans le dashboard IA Settings) ──
# La clé OpenRouter se saisit directement dans le dashboard, pas besoin ici.

# ─── AI (OPENAI — legacy announcements) ─────────────────────
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL="gpt-4o-mini"

# ─── ENVIRONMENT ─────────────────────────────────────────────
NODE_ENV="development"
