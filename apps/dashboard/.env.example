# Database
DATABASE_URL=postgresql://user:password@localhost:5432/discord_manager

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_this_secret_key

# Discord OAuth2
DISCORD_CLIENT_ID=your_application_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Bot API
BOT_API_URL=http://localhost:4000
BOT_API_SECRET=change_this_secret_key

# WebSocket — même port que BOT_API_PORT
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Guild
DISCORD_GUILD_ID=your_guild_id_here
