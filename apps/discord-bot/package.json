{
  "name": "@discord-manager/discord-bot",
  "version": "1.0.0",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "deploy:commands": "ts-node src/deploy-commands.ts"
  },
  "dependencies": {
    "@discord-manager/database": "*",
    "@discord-manager/shared": "*",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.5",
    "openai": "^4.36.0",
    "express": "^4.18.3",
    "socket.io": "^4.7.5",
    "node-cron": "^3.0.3",
    "axios": "^1.6.8"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.21",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
